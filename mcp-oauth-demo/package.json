{
  "name": "mcp-oauth-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP + OAuth 2.1 + Client ID Metadata Document + Protected Resource Metadata の一連の流れを動かすデモ",
  "scripts": {
    "dev": "concurrently -k -n registry,auth,mcp,partner,llm,orch,orch! -c magenta,yellow,green,greenBright,blue,cyan,red \"npm:dev:registry\" \"npm:dev:auth\" \"npm:dev:mcp\" \"npm:dev:partner\" \"npm:dev:llm\" \"npm:dev:orch\" \"npm:dev:orch-untrusted\"",
    "dev:registry": "tsx src/client-registry/server.ts",
    "dev:auth": "tsx src/auth-server/server.ts",
    "dev:mcp": "tsx src/mcp-server/server.ts",
    "dev:partner": "tsx src/partner/server.ts",
    "dev:llm": "tsx src/llm/server.ts",
    "dev:orch": "tsx src/orchestrator/server.ts",
    "dev:orch-untrusted": "ORCHESTRATOR_VARIANT=untrusted tsx src/orchestrator/server.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:untrusted": "tsx scripts/smoke.ts --untrusted",
    "smoke:partner": "tsx scripts/smoke.ts --partner"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
